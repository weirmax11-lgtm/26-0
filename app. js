// ============================================================================
// 26-0: ULTIMATE VFL/AFL SQUAD BUILDER - ENGINE LOGIC
// ============================================================================

// 1. GAME CONFIGURATION
const TOTAL_SLOTS = 19; 
const POSITION_NAMES = [
    "F1", "F2", "F3",       
    "HF1", "HF2", "HF3",   
    "C1", "C2", "C3",       
    "Ruck", "Ruck-Rover", "Rover", 
    "HB1", "HB2", "HB3",   
    "B1", "B2", "B3",       
    "Coach"                 
];

// UPDATED: Standardized exactly to match your scraped database name strings
const TEAM_SLUGS = [
    "adelaide", "brisbaneb", "brisbanel", "carlton", "collingwood", 
    "essendon", "fitzroy", "fremantle", "geelong", "goldcoast", 
    "gws", "hawthorn", "melbourne", "kangaroos", "padelaide", 
    "richmond", "stkilda", "swans", "westcoast", "bulldogs"
];

// 2. STATE CONTROLLERS
let coachesDB = [];
let loadedDecadeData = null;
let currentlyLoadedDecade = ""; 
let currentSlotIndex = 0;
let userSquad = []; 

let currentSpin = { team: "", year: null };

// 3. INITIALIZE GAME DATABASES
async function initGame() {
    try {
        const coachResponse = await fetch('coaches.json');
        coachesDB = await coachResponse.json();
        console.log("Coaches database successfully loaded!");
        startNextTurn();
    } catch (error) {
        console.error("Critical Engine Error: Failed to bootstrap base system files:", error);
        document.getElementById('spinDisplay').innerText = "System Error: Could not load data files.";
    }
}

// 4. RANDOM GENERATION ENGINE
function generateSpin() {
    const randomTeam = TEAM_SLUGS[Math.floor(Math.random() * TEAM_SLUGS.length)];
    const randomYear = Math.floor(Math.random() * (2026 - 1965 + 1)) + 1965;
    
    currentSpin = { team: randomTeam, year: randomYear };
    displaySpinOptions();
}

// 5. DATA FILTERING & ON-DEMAND DECADE FETCHING
async function displaySpinOptions() {
    const currentPosition = POSITION_NAMES[currentSlotIndex];
    const isCoachSlot = currentPosition === "Coach";
    let availableChoices = [];

    // --- COACH SLOT EVALUATION ---
    if (isCoachSlot) {
        availableChoices = coachesDB.filter(c => {
            // Check that the coach's slug matches our active team slug
            if (c.Team_Slug !== currentSpin.team) return false;
            
            const years = c.Seas.split('-');
            const start = parseInt(years[0]);
            const end = years[1] ? parseInt(years[1]) : 2026;
            return currentSpin.year >= start && currentSpin.year <= end;
        });
        
        if (availableChoices.length === 0) {
            availableChoices = coachesDB.filter(c => c.Team_Slug === currentSpin.team);
        }
        
        renderOptionsUI(availableChoices, currentPosition);

    // --- PLAYER SLOT EVALUATION ---
    } else {
        const targetDecade = `${Math.floor(currentSpin.year / 10) * 10}s`;
        
        try {
            if (currentlyLoadedDecade !== targetDecade) {
                const response = await fetch(`decades/${targetDecade}.json`);
                loadedDecadeData = await response.json();
                currentlyLoadedDecade = targetDecade;
                console.log(`Cached file memory reference switched to: ${targetDecade}.json`);
            }
            
            // Normalize names matching exactly with lowercased values from your raw JSON data
            availableChoices = loadedDecadeData.filter(p => 
                p.Year === currentSpin.year && 
                p.Team.toLowerCase().replace(/\s+/g, '') === currentSpin.team
            );
            
            renderOptionsUI(availableChoices, currentPosition);
        } catch (err) {
            console.error(`Data Pipeline Interruption on decade ${targetDecade}:`, err);
            renderOptionsUI([], currentPosition); 
        }
    }
}

// 6. PROCESSING USER SELECTION
function selectCandidate(chosenObject) {
    userSquad.push({
        position: POSITION_NAMES[currentSlotIndex],
        selection: chosenObject,
        isCoach: POSITION_NAMES[currentSlotIndex] === "Coach"
    });

    currentSlotIndex++;

    if (currentSlotIndex < TOTAL_SLOTS) {
        startNextTurn();
    } else {
        calculateFinalScore();
    }
}

function startNextTurn() {
    generateSpin();
}

// 7. STATISTICAL SIMULATION SCORING ENGINE
function calculateFinalScore() {
    let rawSquadScore = 0;

    userSquad.forEach(slot => {
        if (slot.isCoach) {
            const winPct = slot.selection.Total_Pct || 50.0;
            const gfBonus = (slot.selection.GF || 0) * 5; 
            rawSquadScore += (winPct * 0.5) + gfBonus;
        } else {
            const p = slot.selection;
            const playerPower = 
                ((p.DI || 0) * 0.3) +  
                ((p.MK || 0) * 0.5) +  
                ((p.GL || 0) * 1.2) +  
                ((p.BH || 0) * 0.2) +  
                ((p.TK || 0) * 0.8) +  
                ((p.HO || 0) * 0.15) + 
                ((p.BR || 0) * 2.5);   
                
            rawSquadScore += playerPower;
        }
    });

    let calculatedWins = Math.min(26, Math.max(0, Math.floor(rawSquadScore / 280)));
    let calculatedLosses = 26 - calculatedWins;

    console.log(`Simulation Final: Record ${calculatedWins} - ${calculatedLosses}`);
}

// 8. GLOBAL START TRIGGER
window.onload = initGame;
